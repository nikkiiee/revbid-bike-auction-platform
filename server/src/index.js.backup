
import 'dotenv/config';
import http from 'node:http';
import express from 'express';
import cors from 'cors';
import helmet from 'helmet';
import rateLimit from 'express-rate-limit';
import pinoHttp from 'pino-http';
import { Server } from 'socket.io';
import { ZodError } from 'zod';
import mongoose from 'mongoose';
import jwt from 'jsonwebtoken';
import User from './models/User.js';

import { connectDB } from './config/db.js';
import { logger } from './utils/logger.js';
import authRoutes from './routes/auth.js';
import auctionRoutes from './routes/auctions.js';
import { startAuctionLifecycle } from './services/auctionLifecycle.js';

const app = express();
const server = http.createServer(app);

// Allow the frontend to run on either Vite development port.
const allowedOrigins = [
  'http://localhost:5173',
  'http://localhost:5174',
];

// Also allow a custom frontend origin from the .env file.
const configuredOrigin = process.env.CLIENT_ORIGIN;

if (configuredOrigin && !allowedOrigins.includes(configuredOrigin)) {
  allowedOrigins.push(configuredOrigin);
}

const corsOptions = {
  origin: (origin, callback) => {
    // Requests without an Origin header are allowed (e.g. local health checks).
    if (!origin || allowedOrigins.includes(origin)) {
      return callback(null, true);
    }

    return callback(new Error('Not allowed by CORS'));
  },
  methods: ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'],
  credentials: false,
};

const io = new Server(server, {
  cors: {
    ...corsOptions,
    methods: ['GET', 'POST'],
  },
  transports: ['websocket', 'polling'],
});

app.set('io', io);
app.disable('x-powered-by');

app.use(helmet());
app.use(cors(corsOptions));
app.use(express.json({ limit: '32kb' }));
app.use(pinoHttp({ logger }));

// General API rate limit.
app.use(
  '/api',
  rateLimit({
    windowMs: 60_000,
    limit: 300,
    standardHeaders: 'draft-7',
    legacyHeaders: false,
  })
);

// Liveness check.
app.get('/health/live', (_req, res) => {
  res.json({
    status: 'ok',
    uptime: process.uptime(),
  });
});

// Readiness check.
app.get('/health/ready', (_req, res) => {
  const ready = mongoose.connection.readyState === 1;

  res.status(ready ? 200 : 503).json({
    status: ready ? 'ready' : 'not-ready',
  });
});

// Authentication routes with a stricter rate limit.
app.use(
  '/api/auth',
  rateLimit({
    windowMs: 15 * 60_000,
    limit: 30,
    standardHeaders: 'draft-7',
    legacyHeaders: false,
  }),
  authRoutes
);

// Auction routes.
app.use('/api/auctions', auctionRoutes);


io.use(async (socket, next) => {
  try {
    const token = socket.handshake.auth?.token;

    if (!token) {
      return next(new Error('Authentication required'));
    }

    const payload = jwt.verify(token, process.env.JWT_SECRET, {
      issuer: 'bike-auction-api',
      audience: 'bike-auction-client',
    });

    const user = await User.findById(payload.sub)
      .select('_id name email role disabled');

    if (!user || user.disabled) {
      return next(new Error('Account unavailable'));
    }

    socket.data.user = {
      id: String(user._id),
      role: user.role,
    };

    next();
  } catch {
    next(new Error('Invalid or expired token'));
  }
});

// Socket.IO auction room management.
io.on('connection', (socket) => {
  socket.on('auction:join', (auctionId) => {
  if (
    socket.data.user &&
    typeof auctionId === 'string' &&
    /^[a-f\d]{24}$/i.test(auctionId)
  ) {
    socket.join(`auction:${auctionId}`);
  }
});

  socket.on('auction:leave', (auctionId) => {
    if (
      typeof auctionId === 'string' &&
      /^[a-f\d]{24}$/i.test(auctionId)
    ) {
      socket.leave(`auction:${auctionId}`);
    }
  });
});

// Central error handler.
app.use((err, req, res, _next) => {
  if (err instanceof ZodError) {
    return res.status(400).json({
      error: 'Validation failed',
      details: err.issues.map((issue) => ({
        path: issue.path.join('.'),
        message: issue.message,
      })),
    });
  }

  if (err.code === 11000) {
    return res.status(409).json({
      error: 'Duplicate request',
    });
  }

  const status = err.status || 500;

  req.log?.error({ err }, 'Request failed');

  res.status(status).json({
    error:
      status >= 500
        ? 'Internal server error'
        : err.message,
  });
});

const port = Number(process.env.PORT || 5000);

await connectDB();

const stopLifecycle = startAuctionLifecycle(io);

server.listen(port, () => {
  logger.info({ port }, 'Bike auction API listening');
});

// Graceful shutdown.
for (const signal of ['SIGTERM', 'SIGINT']) {
  process.on(signal, () => {
    stopLifecycle();

    server.close(() => {
      process.exit(0);
    });
  });
}
